{
  "name": "lucide-icon-composer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:icons": "node scripts/generate-lucide-catalog.mjs",
    "predev": "npm run prepare:icons",
    "dev": "vite",
    "prebuild": "npm run prepare:icons",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/check-icon-build.mjs",
